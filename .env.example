# Choose one LLM provider: groq, openai, or gemini
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Embeddings (this baseline uses OpenAI embeddings)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=zyro-rag-challenge

# Paths and retrieval settings
HR_PDF_DIR=data/hr_policies
FAISS_INDEX_DIR=faiss_index
EXPECTED_PDF_COUNT=11
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
FETCH_K=15
MMR_LAMBDA=0.5
